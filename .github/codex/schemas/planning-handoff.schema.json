{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-CAS Planning Handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["completed", "approval_required", "blocked"] },
    "milestone_number": { "type": "integer", "minimum": 0 },
    "milestone_name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "runtime_impact": { "type": "string" },
    "data_persistence_impact": { "type": "string" },
    "security_impact": { "type": "string" },
    "privacy_ip_impact": { "type": "string" },
    "deployment_impact": { "type": "string" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "approval_required": { "type": ["string", "null"] },
    "unresolved_items": { "type": "array", "items": { "type": "string" } },
    "recommended_next_action": { "type": ["string", "null"] }
  },
  "required": ["status", "milestone_number", "milestone_name", "summary", "runtime_impact", "data_persistence_impact", "security_impact", "privacy_ip_impact", "deployment_impact", "files_changed", "tests", "approval_required", "unresolved_items", "recommended_next_action"]
}
